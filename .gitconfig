[user]
	name = long-long-float
	email = 3138900+long-long-float@users.noreply.github.com
[core]
	editor = vim
	whitespace = cr-at-eol
	excludesfile = /home/kazuki/.gitignore_global
[push]
	default = simple
[color]
	ui = auto
[alias]
	s = status
	c = commit
	a = add
	d = diff
  co = checkout
  b = branch
  ignore = "!gi() { curl -L -s https://www.gitignore.io/api/$@ ;}; gi"
